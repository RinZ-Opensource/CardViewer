{
  "name": "cardviewer-songdb-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run types:check && npm run typecheck && npm test",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "types:generate": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false",
    "types:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --check",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "typescript": "^5.9.2",
    "wrangler": "4.114.0"
  }
}
