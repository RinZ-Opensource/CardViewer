# JavaScript / Vite outputs
node_modules/
dist/

# Local analysis and extracted reference material
.analysis/

# Local tooling caches
.claude/
.vscode/
.venv/
.wrangler/
__pycache__/
*.py[cod]

# Rust / Tauri outputs
src-tauri/target/

# Mobile source, repository documentation and reproducible tooling are tracked.
# Their generated outputs are ignored here or by a directory-local .gitignore.

# Private generated assets and distributable packs
private-assets/fonts/fot/*
!private-assets/fonts/fot/.gitkeep
private-assets/official/*
!private-assets/official/.gitkeep
*.cmpack
private-assets.zip

# Vite's public/ tree is always copied into dist. Official assets and privately
# licensed fonts must live under private-assets/ and reach public deployments through R2.
public/official/
public/fonts/private/

# Throwaway local scratch files
*.bak
sprite_test.py
holo_compare_output/

# Score-card extraction reference dumps are reproducible from private inputs.
/scripts/scorecard-extract/*_tree.json
/scripts/scorecard-extract/*_tree.txt
/scripts/scorecard-extract/*_dump.json
/scripts/scorecard-extract/ongeki_guid_cache.json
/scripts/scorecard-extract/chk_montage_*.png
