{
  "name": "configarc-card-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --mode private",
    "dev:private": "npm run dev",
    "dev:public": "vite --host 127.0.0.1 --port 1420 --mode public",
    "build": "tsc && vite build --mode private",
    "build:private": "npm run build",
    "build:public": "tsc && vite build --mode public && npm run check:public-dist",
    "check": "npm run check:secrets && npm run test:secrets && npm run check:mobile-boundary && npm run test:mobile-boundary && npm run test:boundaries && npm run test:holo-mask && npm run test:public-dist && npm run test:functions && npm run test:persistence && npm run test:scorecard-input && npm run test:scorecard-defaults && npm run test:cache && npm run build:public && npm run check:functions && npm run check:worker",
    "check:all": "npm run check && npm run check:rust && npm run check:mobile",
    "check:secrets": "node scripts/security/check-tracked-secrets.mjs",
    "check:functions": "node --check \"functions/official/[[path]].js\"",
    "check:mobile": "dotnet build mobile/CardMakerMobile.Tools/CmpackSmoke/CmpackSmoke.csproj --configuration Release",
    "check:mobile-boundary": "node scripts/security/check-mobile-boundary.mjs",
    "check:public-dist": "node check-public-dist.mjs",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check:worker": "npm --prefix workers/songdb-sync run check",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "preview:cloudflare": "npm exec --prefix workers/songdb-sync --offline -- wrangler pages dev dist --r2=ASSETS_BUCKET",
    "preview:public": "npm run preview",
    "test:functions": "node --test tests/pages-functions.test.mjs",
    "test:boundaries": "node --test tests/module-boundaries.test.mjs",
    "test:holo-mask": "node --test tests/holo-mask-math.test.mjs",
    "test:mobile-boundary": "node --test tests/mobile-boundary.test.mjs",
    "test:cache": "node --test tests/cache-reliability.test.mjs",
    "test:persistence": "node --test tests/persistence.test.mjs",
    "test:scorecard-defaults": "node --test tests/scorecard-defaults.test.mjs",
    "test:scorecard-input": "node --test tests/scorecard-input.test.mjs",
    "test:public-dist": "node --test tests/public-dist.test.mjs",
    "test:secrets": "node --test tests/tracked-secrets.test.mjs",
    "export:online": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_online --",
    "export:mobile-pack": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_mobile_pack --",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.16"
  }
}
