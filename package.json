{
  "name": "configarc-card-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:public": "npm run dev",
    "build": "tsc && vite build && npm run check:public-dist",
    "build:public": "npm run build",
    "check": "npm run check:secrets && npm run test:secrets && npm run test:deployment-boundary && npm run test:boundaries && npm run test:import-graph && npm run test:public-dist && npm run test:functions && npm run test:persistence && npm run test:card-edits && npm run test:scorecard-input && npm run test:scorecard-defaults && npm run test:scorecard-selection && npm run test:font-fallbacks && npm run test:text-rendering && npm run test:layers && npm run test:scorecard-layout && npm run test:scorecard-font-layout && npm run test:image-loader && npm run test:manifest-url && npm run test:runtime-json && npm run test:holo-mask && npm run test:cache && npm run build && npm run check:functions && npm run check:worker",
    "check:all": "npm run check",
    "check:secrets": "node scripts/security/check-tracked-secrets.mjs",
    "check:functions": "node --check \"functions/official/[[path]].js\" && node --check functions/official/public-object-policy.js && node --check \"functions/fonts/private/[[path]].js\"",
    "check:public-dist": "node check-public-dist.mjs",
    "check:worker": "npm --prefix workers/songdb-sync run check",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "preview:cloudflare": "npm exec --prefix workers/songdb-sync --offline -- wrangler pages dev dist --r2=ASSETS_BUCKET",
    "preview:public": "npm run preview",
    "test:functions": "node --test tests/pages-functions.test.mjs",
    "test:boundaries": "node --test tests/module-boundaries.test.mjs tests/card-module-boundaries.test.mjs tests/hooks-module-boundaries.test.mjs tests/layers-module-boundaries.test.mjs tests/runtime-json-module-boundaries.test.mjs tests/text-rendering-module-boundaries.test.mjs",
    "test:import-graph": "node --test tests/import-graph.test.mjs",
    "test:deployment-boundary": "node --test tests/deployment-boundary.test.mjs",
    "test:holo-mask": "node --test tests/holo-mask-math.test.mjs",
    "test:image-loader": "node --test tests/image-loader.test.mjs",
    "test:manifest-url": "node --test tests/manifest-url.test.mjs",
    "test:runtime-json": "node --test tests/runtime-json.test.mjs",
    "test:cache": "node --test tests/cache-reliability.test.mjs",
    "test:persistence": "node --test tests/persistence.test.mjs",
    "test:card-edits": "node --test tests/card-edits.test.mjs",
    "test:scorecard-defaults": "node --test tests/scorecard-defaults.test.mjs",
    "test:scorecard-selection": "node --test tests/scorecard-selection.test.mjs",
    "test:scorecard-input": "node --test tests/scorecard-input.test.mjs",
    "test:font-fallbacks": "node --test tests/font-fallbacks.test.mjs",
    "test:text-rendering": "node --test tests/text-rendering.test.mjs",
    "test:layers": "node --test tests/layers.test.mjs",
    "test:scorecard-layout": "node --test tests/scorecard-layout.test.mjs",
    "test:scorecard-font-layout": "node --test tests/scorecard-font-layout.test.mjs",
    "test:public-dist": "node --test tests/public-dist.test.mjs",
    "test:secrets": "node --test tests/tracked-secrets.test.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.16"
  }
}
