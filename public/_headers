# Cloudflare Pages headers file (ignored by the Tauri build).
#
# Preload the sharded card manifest index so the browser starts fetching it
# during HTML parse, before the JS bundle boots and requests it. Cloudflare can
# also promote this Link header to an HTTP 103 Early Hint when Early Hints is
# enabled on the zone. The manifest is same-origin, so no `crossorigin`
# attribute is used — that matches the app's plain `fetch()` and avoids a
# duplicate request.
/
  Link: </official/generated/cards.index.json>; rel=preload; as=fetch
/index.html
  Link: </official/generated/cards.index.json>; rel=preload; as=fetch
